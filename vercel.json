{
  "framework": "vite",
  "crons": [
    {
      "path": "/api/check-transfer",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    { 
      "source": "/((?!api/).*)", 
      "destination": "/index.html" 
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
